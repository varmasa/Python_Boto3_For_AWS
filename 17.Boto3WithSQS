import boto3
def lambda_handler(event, context):
    sqs = boto3.client(
        "sqs",
        region_name="ap-south-1"
    )
    queue_url = "https://sqs.ap-south-1.amazonaws.com/876163988748/test.fifo"
    response = sqs.send_message(
        QueueUrl=queue_url,
        MessageBody="Hello from Boto3!",
        MessageGroupId="test-group",
        MessageDeduplicationId="message-001"
    )
    print(response)
    return {
        "statusCode": 200,
        "body": "Message sent successfully"
    }


What are these two parameters?
For a FIFO queue, think of them like this:

FIFO Queue
    │
    ├── MessageGroupId
    │       ↓
    │   Which group/order?
    │
    └── MessageDeduplicationId
            ↓
        Is this a duplicate?
