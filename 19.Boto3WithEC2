import boto3

REGION = "ap-south-1"

ec2 = boto3.client(
    "ec2",
    region_name=REGION
)


def lambda_handler(event, context):

    # 1. Find EC2 instances with Env=dev

    paginator = ec2.get_paginator("describe_instances")

    instances = []

    for page in paginator.paginate(
        Filters=[
            {
                "Name": "tag:Env",
                "Values": ["dev"]
            }
        ]
    ):

        for reservation in page["Reservations"]:

            for instance in reservation["Instances"]:

                instances.append({
                    "InstanceId": instance["InstanceId"],
                    "State": instance["State"]["Name"]
                })


    print("\n=== EC2 Instances with Env=dev ===")

    for instance in instances:

        print(
            instance["InstanceId"],
            "->",
            instance["State"]
        )


    # 2. Find running instances

    running_instances = [
        instance["InstanceId"]
        for instance in instances
        if instance["State"] == "running"
    ]


    # 3. Stop running instances

    if running_instances:

        print("\nStopping instances:")

        print(running_instances)

        ec2.stop_instances(
            InstanceIds=running_instances
        )


        # 4. Wait until instances are stopped

        print("\nWaiting for instances to stop...")

        waiter = ec2.get_waiter("instance_stopped")

        waiter.wait(
            InstanceIds=running_instances
        )

        print("All instances stopped.")

    else:

        print("\nNo running dev instances found.")


    # 5. Create report

    print("\n========== REPORT ==========")

    report = []

    for instance in instances:

        if instance["InstanceId"] in running_instances:

            final_state = "stopped"

        else:

            final_state = instance["State"]


        print(
            f"Instance: {instance['InstanceId']} | "
            f"Before: {instance['State']} | "
            f"After: {final_state}"
        )

        report.append({
            "InstanceId": instance["InstanceId"],
            "Before": instance["State"],
            "After": final_state
        })


    print("============================")


    # Lambda response

    return {
        "statusCode": 200,
        "body": report
    }
